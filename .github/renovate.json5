{
  extends: [
    'config:recommended',
    ':semanticCommits',
    ':semanticCommitTypeAll(chore)',
    'helpers:pinGitHubActionDigests',
  ],
  enabledManagers: ['cargo', 'github-actions'],
  packageRules: [
    {
      groupName: 'arrow-datafusion',
      matchManagers: ['cargo'],
      matchPackageNames: ['/^arrow(-.*)?$/', '/^datafusion(-.*)?$/'],
    },
  ],
}
